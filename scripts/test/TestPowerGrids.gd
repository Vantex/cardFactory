extends Node
var failures := 0
func _ready() -> void:
	var state := GameState.new()
	var solar := state.add_building({"type": "solar_panel", "position": Vector2.ZERO, "generation_factor": 50.0 / 360.0})
	var high := state.add_building({"type": "smelter", "position": Vector2(5000, 0), "power_priority": 3})
	var low := state.add_building({"type": "smelter", "position": Vector2.ZERO, "power_grid_id": "grid-b"})
	var power := PowerSystem.new(state)
	power.update(1.0)
	check(state.buildings[low].power_efficiency == 0, "grids on same planet are isolated")
	check(state.buildings[high].power_efficiency == 1, "same-grid source covers consumer regardless of distance")
	state.set_entity_power_grid(low, "grid-a")
	state.buildings[low].power_priority = 1
	power.update(1.0)
	check(state.buildings[high].power_efficiency == 1 and state.buildings[low].power_efficiency == 0, "priority three receives power before priority one")
	if not power.has_method("get_grid_info"):
		check(false, "grid diagnostics and storage implementation required")
	else:
		_test_edges()
		_test_storage()
		_test_configuration()
		_test_exchanger_and_dispatch()
		_test_environment_refresh()
	if failures == 0: print("POWER GRID TESTS PASSED")
	else: printerr("POWER GRID TESTS FAILED")
	get_tree().quit(0 if failures == 0 else 1)
func _test_storage() -> void:
	var state := GameState.new()
	state.add_building({"type": "solar_panel", "position": Vector2.ZERO})
	var battery := state.add_building({"type": "accumulator", "position": Vector2.ZERO})
	var power := PowerSystem.new(state)
	power.update(1.0)
	check(is_equal_approx(state.buildings[battery].get("stored_energy_mj", 0), 0.36), "360 kW for one second stores 0.36 MJ")
	var info: Dictionary = power.get_grid_info("home", "grid-a")
	check(is_equal_approx(info.actual_generation, info.supplied + info.storage_charge + info.spilled), "grid ledger conserves generated power")
	state.buildings.erase(state.buildings.keys()[0])
	var consumer := state.add_building({"type": "smelter", "position": Vector2.ZERO})
	power.update(1.0)
	check(is_equal_approx(state.buildings[battery].stored_energy_mj, 0.31) and state.buildings[consumer].power_efficiency == 1, "battery supplies demand with exact energy debit")
	for building in state.buildings.values():
		building.merge({"input_buffer": {}, "output_buffer": {}, "recipe_id": "", "progress": 0.0, "speed": 1.0}, false)
	var decoded := GameStateCodec.from_persistent_dict(GameStateCodec.to_persistent_dict(state))
	check(decoded != null and is_equal_approx(decoded.buildings[battery].stored_energy_mj, 0.31), "stored energy survives codec round trip")
func _test_configuration() -> void:
	var state := GameState.new()
	var id := state.add_building({"type": "solar_panel", "position": Vector2.ZERO})
	var before := GameStateCodec.to_persistent_dict(state)
	check(not state.set_entity_power_priority(id, 9), "invalid priority is rejected rather than silently clamped")
	check(before == GameStateCodec.to_persistent_dict(state), "rejected configuration preserves all state")
func check(ok: bool, message: String) -> void:
	if ok: print("PASS: " + message)
	else:
		failures += 1
		printerr("FAIL: " + message)

func _test_environment_refresh() -> void:
	var state := GameState.new()
	SourceGalaxySystem.new(state).initialize(240721, true)
	var first := state.add_building({"type": "dsp_solar_panel", "planet_id": "home", "generation_factor": 1.0})
	var second := state.add_building({"type": "dsp_solar_panel", "planet_id": "home", "generation_factor": 0.5, "power_grid_id": "grid-b"})
	var distant := state.add_building({"type": "dsp_solar_panel", "planet_id": "frost"})
	var consumer := state.add_building({"type": "smelter", "planet_id": "home"})
	var power := PowerSystem.new(state)
	power.update(1.0)
	var rated := float(DataManager.get_building("dsp_solar_panel").power_generation)
	check(is_equal_approx(state.buildings[first].power_output, rated * PowerSystem.source_environment_multiplier(state, "dsp_solar_panel", "home")), "source solar uses current home environment")
	check(is_equal_approx(state.buildings[second].power_output, state.buildings[first].power_output * 0.5), "shared planet environment preserves individual factors across grids")
	check(is_equal_approx(state.buildings[distant].power_output, rated * PowerSystem.source_environment_multiplier(state, "dsp_solar_panel", "frost")), "planet environments remain isolated")
	var previous := float(state.buildings[first].power_output)
	var system_id: String = GalaxySystem.new(state).get_planet("home").system_id
	state.source_galaxy.systemProfiles[system_id].luminosity *= 0.5
	state.difficulty = "hard"
	power.update(1.0)
	check(is_equal_approx(state.buildings[first].power_output, previous * 0.5), "next power update refreshes changed stellar luminosity")
	check(is_equal_approx(state.buildings[consumer].power_requested, float(DataManager.get_building("smelter").power_demand) * 1.2), "next power update refreshes difficulty demand")
	state.buildings[second].generation_factor = 0.25
	power.update(1.0)
	check(is_equal_approx(state.buildings[second].power_output, state.buildings[first].power_output * 0.25), "next power update refreshes individual generation factor")
func _test_exchanger_and_dispatch() -> void:
	var state := GameState.new()
	var solar := state.add_building({"type": "solar_panel", "position": Vector2.ZERO})
	var exchange := state.add_building({"type": "energy_exchanger", "position": Vector2.ZERO, "input_buffer": {"accumulator": 1.0}, "output_buffer": {}})
	var power := PowerSystem.new(state)
	power.update(250.0)
	check(state.buildings[exchange].output_buffer.get("charged_accumulator", 0) == 1 and state.buildings[exchange].input_buffer.accumulator == 0, "90 MJ surplus converts exactly one empty cell")
	check(state.set_energy_mode(exchange, "discharge"), "empty exchanger can change mode")
	state.buildings[exchange].input_buffer = {"charged_accumulator": 1.0}
	state.buildings[exchange].output_buffer = {}
	state.buildings.erase(solar)
	state.add_building({"type": "smelter", "position": Vector2.ZERO})
	power.update(10.0)
	check(is_equal_approx(state.buildings[exchange].stored_energy_mj, 89.5), "exchanger consumes only demanded energy from one loaded cell")
	check(not state.set_energy_mode(exchange, "charge"), "partial cell cannot be relabeled to create or lose energy")
	state.buildings[exchange].output_buffer = {"accumulator": 120.0}
	power.update(10.0)
	check(is_equal_approx(state.buildings[exchange].stored_energy_mj, 89.5), "full output holds the in-progress cell without energy loss")
	state.buildings[exchange].output_buffer = {}
	power.update(1790.0)
	check(state.buildings[exchange].output_buffer.get("accumulator", 0) == 1 and is_zero_approx(state.buildings[exchange].stored_energy_mj), "complete discharge returns one empty cell")
	var fuel := state.add_building({"type": "power_generator", "position": Vector2.ZERO, "input_buffer": {"coal": 2.0}, "generation_priority": 3})
	var reserve := state.add_building({"type": "accumulator", "position": Vector2.ZERO, "stored_energy_mj": 90.0, "generation_priority": 1})
	power.update(1.0)
	check(is_equal_approx(state.buildings[fuel].power_output, 50) and state.buildings[reserve].power_output == 0, "generation priority dispatches fuel ahead of reserve")
	state.set_entity_generation_priority(reserve, 3)
	state.set_entity_generation_priority(fuel, 1)
	var remaining: float = state.buildings[fuel].fuel_remaining
	power.update(1.0)
	check(state.buildings[fuel].power_output == 0 and state.buildings[fuel].fuel_remaining == remaining, "standby generator retains fuel when higher priority storage covers demand")
	var info: Dictionary = power.get_grid_info("home", "grid-a")
	check(is_equal_approx(info.actual_generation, info.supplied + info.storage_charge + info.spilled), "discharge ledger conserves energy")
	var snapshot := GameStateCodec.to_persistent_dict(state)
	check(not state.try_configure_power_entities([fuel, "absent"], {"power_grid_id": "grid-c"}).ok and snapshot == GameStateCodec.to_persistent_dict(state), "batch preflight prevents partial grid reassignment")
	state.set_entity_power_grid(reserve, "grid-c")
	power.update(1.0)
	check(state.buildings[reserve].power_output == 0, "isolated reserve cannot backfeed another grid")
	for building in state.buildings.values():
		building.merge({"input_buffer": {}, "output_buffer": {}, "recipe_id": "", "progress": 0.0, "speed": 1.0}, false)
	var storage := SaveSystem.new("res://.godot/task21-persistence-%d/" % Time.get_ticks_usec())
	var saved := storage.save_slot(0, state)
	if not saved.ok: print(saved)
	check(saved.ok, "power configuration and residual energy survive verified disk write")
	var restored := storage.load_slot(0)
	check(restored.ok and restored.state.buildings[reserve].power_grid_id == "grid-c", "disk restore retains stable grid IDs")

func _test_edges() -> void:
	var state := GameState.new()
	var source := state.add_building({"type": "solar_panel", "generation_factor": 50.0 / 360.0})
	var a := state.add_building({"type": "smelter", "progress": 0.4, "input_buffer": {"iron_ore": 2.0}})
	var b := state.add_building({"type": "smelter"})
	var power := PowerSystem.new(state)
	power.update(1)
	check(is_equal_approx(state.buildings[a].power_input, 25) and is_equal_approx(state.buildings[b].power_input, 25), "equal priority consumers share shortage proportionally")
	state.set_entity_power_grid(a, "grid-b")
	check(state.buildings[a].progress == 0.4 and state.buildings[a].input_buffer.iron_ore == 2, "grid reassignment preserves inventory and progress")
	state.buildings.erase(source)
	power.update(1)
	check(not state.buildings[b].power_covered and state.buildings[b].power_input == 0, "removing last source removes coverage")
	state = GameState.new()
	state.add_building({"type": "solar_panel"})
	var battery := state.add_building({"type": "accumulator", "stored_energy_mj": 89.9})
	power = PowerSystem.new(state)
	power.update(1)
	check(is_equal_approx(state.buildings[battery].stored_energy_mj, 90), "charging never exceeds 90 MJ")
	var info := power.get_grid_info("home", "grid-a")
	check(is_equal_approx(info.spilled, 260), "full storage reports unused surplus")
	power.update(0)
	check(state.buildings[battery].stored_energy_mj == 90, "zero duration does not mutate stored energy")
	state.buildings[battery].stored_energy_mj = 0
	for tick in range(60):
		power.update(1.0 / 60.0)
		info = power.get_grid_info("home", "grid-a")
		check(is_equal_approx(info.actual_generation, info.supplied + info.storage_charge + info.spilled), "fixed tick conserves power")
	check(is_equal_approx(state.buildings[battery].stored_energy_mj, 0.36), "sixty fixed ticks match one second of charging")
	var exchanger := state.add_building({"type": "energy_exchanger", "recipe_id": ""})
	check(state.buildings[exchanger].recipe_id == "charge_accumulator", "new exchanger exposes charge recipe for material delivery")

	var discharger := state.add_building({"type": "energy_exchanger", "energy_mode": "discharge"})
	check(state.buildings[discharger].recipe_id == "discharge_accumulator", "explicit discharge mode keeps matching default recipe")
